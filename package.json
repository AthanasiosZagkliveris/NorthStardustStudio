{
  "name": "northstarduststudio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "node scripts/tokens/generate.mjs",
    "tokens:check": "node scripts/tokens/generate.mjs --check",
    "library": "node scripts/library/run.mjs",
    "cards:scan": "node scripts/cards/scan.mjs",
    "cards:report": "node scripts/cards/report.mjs",
    "docs:values": "node scripts/docs/sync-values.mjs",
    "docs:values:check": "node scripts/docs/sync-values.mjs --check",
    "docs:assets": "node scripts/docs/generate-assets.mjs",
    "docs:assets:check": "node scripts/docs/generate-assets.mjs --check",
    "docs:check": "npm run docs:values:check && npm run docs:assets:check",
    "lint:styles": "node scripts/lint/lint-styles.mjs",
    "lint:styles:baseline": "node scripts/lint/lint-styles.mjs --write-baseline",
    "tauri": "tauri",
    "check:layout": "node scripts/layout-check/run.mjs --quick",
    "check:layout:baseline": "node scripts/layout-check/run.mjs --quick --write-baseline",
    "check:layout:wide": "node scripts/layout-check/run.mjs --wide",
    "check:layout:wide:baseline": "node scripts/layout-check/run.mjs --wide --write-baseline"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.64.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
