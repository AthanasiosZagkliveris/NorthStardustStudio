{
  "name": "northstarduststudio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "node tools/scripts/tokens/generate.mjs",
    "tokens:check": "node tools/scripts/tokens/generate.mjs --check",
    "library": "node tools/scripts/library/run.mjs",
    "cards:scan": "node tools/scripts/cards/scan.mjs",
    "cards:report": "node tools/scripts/cards/report.mjs",
    "catalogue": "node tools/scripts/catalogue/query.mjs",
    "docs:values": "node tools/scripts/docs/sync-values.mjs",
    "docs:values:check": "node tools/scripts/docs/sync-values.mjs --check",
    "docs:index": "node tools/scripts/docs/write-index.mjs",
    "docs:assets": "node tools/scripts/docs/generate-assets.mjs",
    "docs:assets:check": "node tools/scripts/docs/generate-assets.mjs --check",
    "docs:check": "npm run docs:values:check && npm run docs:assets:check",
    "verify": "tsc --noEmit && vitest run && npm run tokens:check && npm run lint:styles && npm run lint:controls && npm run lint:css && npm run docs:check && npm run tables:check && npm run library:check",
    "lint:styles": "node tools/scripts/lint/lint-styles.mjs",
    "lint:css": "node tools/scripts/lint/css-usage.mjs --check && node tools/scripts/lint/css-shadowed.mjs --check",
    "lint:controls": "node tools/scripts/lint/shared-controls.mjs",
    "lint:controls:baseline": "node tools/scripts/lint/shared-controls.mjs --write-baseline",
    "lint:styles:baseline": "node tools/scripts/lint/lint-styles.mjs --write-baseline",
    "tauri": "tauri",
    "export:app": "node tools/scripts/export/app.mjs",
    "check:console": "node tools/scripts/layout-check/console-walk.mjs",
    "check:layout": "node tools/scripts/layout-check/run.mjs --quick",
    "check:layout:baseline": "node tools/scripts/layout-check/run.mjs --quick --write-baseline",
    "check:layout:wide": "node tools/scripts/layout-check/run.mjs --wide",
    "check:layout:wide:baseline": "node tools/scripts/layout-check/run.mjs --wide --write-baseline",
    "tables": "node tools/scripts/catalogue/structure.mjs --md docs/design/core/07-structure-tables.md --ts src/library/tables",
    "tables:check": "node tools/scripts/catalogue/structure.mjs --check --md docs/design/core/07-structure-tables.md --ts src/library/tables",
    "library:doc": "node tools/scripts/library/generate-library-doc.mjs",
    "library:doc:check": "node tools/scripts/library/generate-library-doc.mjs --check",
    "library:check": "node tools/scripts/library/library-log.mjs",
    "library:log": "node tools/scripts/library/library-log.mjs log",
    "library:looks": "node tools/scripts/library/looks.mjs",
    "library:defaults": "node tools/scripts/library/defaults-doc.mjs",
    "library:defaults:check": "node tools/scripts/library/defaults-doc.mjs --check",
    "library:components": "node tools/scripts/library/components-list.mjs",
    "library:components:check": "node tools/scripts/library/components-list.mjs --check",
    "library:fields-list": "node tools/scripts/library/fields-list.mjs",
    "library:fields-list:check": "node tools/scripts/library/fields-list.mjs --check",
    "library:compare": "node tools/scripts/library/app-compare.mjs",
    "library:compare:check": "node tools/scripts/library/app-compare.mjs --check",
    "library:tokens": "node tools/scripts/library/component-tokens.mjs",
    "library:tokens:check": "node tools/scripts/library/component-tokens.mjs --check",
    "library:csv": "node tools/scripts/library/export-csv.mjs",
    "library:csv:check": "node tools/scripts/library/export-csv.mjs --check",
    "library:downloads": "node tools/scripts/library/downloads.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.64.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
