# Cloudflare Pages headers for the Tiles web app at app.northstardust.studio (docs/proposals/apps-on-every-system.md,
# G4). Copied into dist/ by the build (public/). The same style as the website's own _headers.
#
# The security policy (CSP): everything from the app itself. 'unsafe-inline' for styles only, because React sets a few
# style attributes; images also from data: and blob: (an Organisation's uploaded logo, exports); the service worker
# and the manifest from the app.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin

# Built files carry a content hash in their names: a year, immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker and the manifest are checked on every visit, so an update reaches installed copies.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
